# Copia este archivo a .env y ajusta los valores. .env nunca se versiona.

# Entorno de ejecucion: development | test | production
NODE_ENV=development

# Puerto HTTP local. En Vercel esta variable no se usa (la plataforma la asigna).
PORT=3000

# Cadena de conexion a PostgreSQL.
# Local (Docker, ver docker-compose.yml). Puerto 5433 en el host (no 5432)
# para no chocar con un PostgreSQL nativo que ya pueda estar instalado:
DATABASE_URL=postgresql://pt_user:pt_password@localhost:5433/pt_interactuar_dev
# Produccion (Neon, cadena CON pooler, nunca la directa): postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Origenes permitidos para CORS, separados por coma. Sin espacios.
CORS_ORIGIN=http://localhost:4200

# Nivel de log: debug | info | warn | error | silent
LOG_LEVEL=debug

# Maximo de peticiones por IP cada 15 minutos antes de responder 429.
RATE_LIMIT_MAX=1000

# Igual que RATE_LIMIT_MAX pero solo para POST/PUT/PATCH/DELETE (mas estricto).
RATE_LIMIT_WRITE_MAX=200

# Limite propio de POST /api/v1/demo/reset, mucho mas bajo que el de escrituras:
# ese endpoint borra y resiembra toda la base y no lleva token.
# En local se sube para poder correr la suite de tests.
RATE_LIMIT_DEMO_MAX=50

# Activa el endpoint POST /api/v1/demo/reset, que restaura los datos de ejemplo.
# Con DEMO_MODE=false la ruta no se monta y responde 404.
DEMO_MODE=true
